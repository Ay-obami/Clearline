# Signer service (one deployment per signer — never share keys across instances)

# HSK Chain testnet RPC. Use a dedicated endpoint (e.g. Chainstack) for live demos.
RPC_URL=https://testnet.hsk.xyz

# This signer's private key (holders a signing share; NOT the deployer key).
# Generate: cast wallet new
PRIVATE_KEY=0x

# Deployed Clearline contract addresses (from script/Deploy.s.sol output)
REGISTRY=0x
COMPLIANCE=0x
SIGNER=0x
SETTLEMENT=0x

# Health port for Railway/system-status checks
PORT=8787

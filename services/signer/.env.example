# Signer service — one deployment per signer instance, unique PRIVATE_KEY each.
# Variable names MUST match services/signer/src/index.ts exactly.

# Target network RPC (dedicated endpoint e.g. Chainstack recommended for prod).
RPC_URL=https://testnet.hsk.xyz

# ChainId of target network: testnet=133, mainnet=177.
# MUST match the deployed network — EIP-712 digests bind the chain id!
CHAIN_ID=133

# This signer's private key. Holds a signing share of the InstructionSigner
# threshold — treat as custody-grade secret. Generate: cast wallet new
PRIVATE_KEY=0x

# Deployed Clearline addresses (from script/Deploy.s.sol output).
REGISTRY_ADDRESS=0x
SIGNER_CONTRACT=0x

# Health check port (Railway/system tab)
HEALTH_PORT=8080


# Mock custodian / settlement service

# HSK Chain testnet RPC. Use a dedicated endpoint (e.g. Chainstack) for live demos.
RPC_URL=https://testnet.hsk.xyz

# Custodian relayer key used ONLY to post settlement confirmations to
# SettlementRecorder.recordSettlement(). Fund it with a little testnet HSK.
CUSTODIAN_KEY=0x

# Deployed Clearline contract addresses (from script/Deploy.s.sol output)
REGISTRY=0x
SIGNER=0x
SETTLEMENT=0x

# Health port
PORT=8788

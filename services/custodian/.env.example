# Mock custodian / settlement service.
# Variable names MUST match services/custodian/src/index.ts exactly.

# Target network RPC (dedicated endpoint e.g. Chainstack recommended for prod).
RPC_URL=https://testnet.hsk.xyz

# ChainId of target network: testnet=133, mainnet=177.
CHAIN_ID=133

# Relayer key used ONLY to post settlement confirmations to
# SettlementRecorder.confirmSettlement(). Its address must be an authorized
# attestor (set via settlement.setAttestor at deploy time).
PRIVATE_KEY=0x

# Deployed Clearline addresses (from script/Deploy.s.sol output).
REGISTRY_ADDRESS=0x
SIGNER_CONTRACT=0x
SETTLEMENT_ADDRESS=0x

# Simulated T+ settlement delay before posting confirmation.
SETTLEMENT_DELAY_MS=15000

# Health check port
HEALTH_PORT=8081


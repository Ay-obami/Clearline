# frontend — ONE SET OF VALUES PER DEPLOYMENT TARGET.
# The same code builds for testnet or mainnet; only env differs
# (e.g. two Vercel projects, or Vercel preview vs production).

# --- testnet (chainId 133) ---
NEXT_PUBLIC_CHAIN_ID=133
NEXT_PUBLIC_RPC_URL=https://testnet.hsk.xyz
NEXT_PUBLIC_EXPLORER=https://testnet-explorer.hskchain.net/
NEXT_PUBLIC_CHAIN_NAME=HSK Chain Testnet
NEXT_PUBLIC_ENVIRONMENT=testnet

# --- mainnet reference values (uncomment + fill addresses when deploying) ---
# NEXT_PUBLIC_CHAIN_ID=177
# NEXT_PUBLIC_RPC_URL=https://mainnet.hsk.xyz
# NEXT_PUBLIC_EXPLORER=https://hsk.blockscout.com/
# NEXT_PUBLIC_CHAIN_NAME=HSK Chain
# NEXT_PUBLIC_ENVIRONMENT=mainnet

# paste deployed addresses after running script/Deploy.s.sol against the target RPC
NEXT_PUBLIC_REGISTRY=0x
NEXT_PUBLIC_DIRECT_BURN_ADAPTER=0x
NEXT_PUBLIC_REQUEST_LOCK_ADAPTER=0x
NEXT_PUBLIC_COMPLIANCE=0x
NEXT_PUBLIC_SIGNER=0x
NEXT_PUBLIC_BREAKER=0x
NEXT_PUBLIC_SETTLEMENT=0x
NEXT_PUBLIC_IDENTITY=0x
NEXT_PUBLIC_TOKEN=0x
# optional service health panel URLs, e.g. Signer1=http://...,Signer2=http://...,Custodian=http://...
NEXT_PUBLIC_HEALTH_URLS=


# Clearline deployment addresses captured from Deploy.s.sol output.
# Copy to deployments/local.env and fill after running:
#   forge script script/Deploy.s.sol:ClearlineDeploy --rpc-url <url> --broadcast
TOKEN_ADDRESS=0x
REGISTRY_ADDRESS=0x
IDENTITY_ADDRESS=0x
DIRECT_BURN_ADAPTER=0x
REQUEST_LOCK_ADAPTER=0x
COMPLIANCE_ADDRESS=0x
SIGNER_ADDRESS=0x
BREAKER_ADDRESS=0x
SETTLEMENT_ADDRESS=0x
# optional: keys the demo script uses (defaults to Anvil dev accounts).
# Only needed if BOARD/HOLDER keys differ from Anvil defaults.
#HOLDER_KEY=0x
#BOARD_KEY_A=0x
#BOARD_KEY_B=0x
